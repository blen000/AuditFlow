/**
 * @fileoverview Firestore Security Rules for the audit findings application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to all data while restricting write access.
 *
 * Data Structure:
 * The Firestore database consists of several top-level collections: `branches`, `districts`,
 * `riskLevels`, `statuses`, and `findings`.  All collections are designed for public read access.
 *
 * Key Security Decisions:
 * - Public Read Access: All `get` and `list` operations are allowed for all users, including
 *   unauthenticated users.
 * - Restricted Writes: All `create`, `update`, and `delete` operations are denied to prevent
 *   unauthorized data modification.
 * - No User-Specific Data: This application does not currently implement user-specific data
 *   or ownership. If user-specific data is introduced, these rules will need to be updated
 *   to enforce proper authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to branch data, but restricts all writes.
     * @path /branches/{branchId}
     * @allow (get, list) Any user (signed in or not) can read branch data.
     * @deny (create, update, delete) No user can create, update, or delete branch data.
     * @principle Public read, no writes.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to district data, but restricts all writes.
     * @path /districts/{districtId}
     * @allow (get, list) Any user (signed in or not) can read district data.
     * @deny (create) The error reported in the user request occurs because this rule was missing, resulting in insufficient permissions.
     * @deny (update, delete) No user can update or delete district data.
     * @principle Public read, no writes.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to risk level data, but restricts all writes.
     * @path /riskLevels/{riskLevelId}
     * @allow (get, list) Any user (signed in or not) can read risk level data.
     * @deny (create, update, delete) No user can create, update, or delete risk level data.
     * @principle Public read, no writes.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to status data, but restricts all writes.
     * @path /statuses/{statusId}
     * @allow (get, list) Any user (signed in or not) can read status data.
     * @deny (create, update, delete) No user can create, update, or delete status data.
     * @principle Public read, no writes.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to audit finding data, but restricts all writes.
     * @path /findings/{findingId}
     * @allow (get, list) Any user (signed in or not) can read audit finding data.
     * @deny (create, update, delete) No user can create, update, or delete audit finding data.
     * @principle Public read, no writes.
     */
    match /findings/{findingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}