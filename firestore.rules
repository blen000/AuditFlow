/**
 * @file Firestore Security Rules
 * @description This ruleset defines access control for the Firestore database.
 *
 * Core Philosophy:
 * This ruleset provides open read access to all collections while restricting write access. Write access is currently denied to all users.
 *
 * Data Structure:
 * The database contains several top-level collections: `branches`, `districts`, `riskLevels`, `statuses`, and `findings`.
 *
 * Key Security Decisions:
 * - All collections are publicly readable, including `list` operations.
 * - All write operations (create, update, delete) are currently denied.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read the list of branches. Writes are disallowed.
     * @path /branches/{branchId}
     * @allow (get, list): Any user can read a branch or list all branches.
     * @deny (create, update, delete): No one can create, update, or delete branches.
     * @principle Public read access with no writes.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read the list of districts. Writes are disallowed.
     * @path /districts/{districtId}
     * @allow (get, list): Any user can read a district or list all districts.
     * @deny (create, update, delete): No one can create, update, or delete districts.
     * @principle Public read access with no writes.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read the list of riskLevels. Writes are disallowed.
     * @path /riskLevels/{riskLevelId}
     * @allow (get, list): Any user can read a riskLevel or list all riskLevels.
     * @deny (create, update, delete): No one can create, update, or delete riskLevels.
     * @principle Public read access with no writes.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read the list of statuses. Writes are disallowed.
     * @path /statuses/{statusId}
     * @allow (get, list): Any user can read a status or list all statuses.
     * @deny (create, update, delete): No one can create, update, or delete statuses.
     * @principle Public read access with no writes.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read the list of findings. Writes are disallowed.
     * @path /findings/{findingId}
     * @allow (get, list): Any user can read a finding or list all findings.
     * @deny (create, update, delete): No one can create, update, or delete findings.
     * @principle Public read access with no writes.
     */
    match /findings/{findingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}