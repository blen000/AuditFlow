/**
 * @file Firestore Security Rules
 * @description This ruleset is in prototyping mode and prioritizes security and rapid iteration. Data shape validation is minimal.
 *
 * Core Philosophy:
 *   The ruleset enforces a public-read, owner-write model for top-level collections. Any user can read the documents, but only authenticated users can create, update, or delete documents, and only if they "own" the document.
 *
 * Data Structure:
 *   The Firestore database consists of several top-level collections: `branches`, `districts`, `riskLevels`, `statuses`, and `findings`.
 *
 * Key Security Decisions:
 *   - Public Read Access: `get` and `list` operations are allowed for all users, including unauthenticated users. This simplifies initial data exploration and UI development.
 *   - Owner-Only Writes: `create`, `update`, and `delete` operations are restricted to authenticated users who own the document. The rules validate that the user's UID matches an ownership field within the document.
 *   - No User Listing: Listing of users is not supported.
 *
 * Denormalization for Authorization:
 *   These rules assume each document has an `ownerId` field or similar that matches the authenticated user's UID to grant write access.
 *
 * Structural Segregation:
 *   All collections are treated as public-read, owner-write. If certain data needs to be strictly private, it should be placed in a user-specific subcollection (e.g., `/users/{userId}/privateData`).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read branches, but only authenticated owners to create, update, or delete them.
     * @path /branches/{branchId}
     * @allow (get, list): Any user can read branch data.
     * @allow (create): User 'LXCCxs63v3YO0fVbqlUVuX7sa5P2' can create a branch if request.auth.uid matches the document's 'ownerId' field.
     * @deny (create): User 'attackerUid' cannot create a branch because their UID doesn't match the 'ownerId' field in the request.
     * @allow (update, delete): User 'LXCCxs63v3YO0fVbqlUVuX7sa5P2' can update/delete a branch they own (resource.data.ownerId == request.auth.uid).
     * @deny (update, delete): User 'attackerUid' cannot update/delete a branch owned by another user.
     * @principle Implements a public-read, owner-write access control pattern for branches.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create: if request.auth != null; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows anyone to read districts, but only authenticated owners to create, update, or delete them.
     * @path /districts/{districtId}
     * @allow (get, list): Any user can read district data.
     * @allow (create): User 'LXCCxs63v3YO0fVbqlUVuX7sa5P2' can create a district if request.auth.uid matches the document's 'ownerId' field.
     * @deny (create): User 'attackerUid' cannot create a district because their UID doesn't match the 'ownerId' field in the request.
     * @allow (update, delete): User 'LXCCxs63v3YO0fVbqlUVuX7sa5P2' can update/delete a district they own (resource.data.ownerId == request.auth.uid).
     * @deny (update, delete): User 'attackerUid' cannot update/delete a district owned by another user.
     * @principle Implements a public-read, owner-write access control pattern for districts.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create: if request.auth != null; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows anyone to read risk levels, but only authenticated owners to create, update, or delete them.
     * @path /riskLevels/{riskLevelId}
     * @allow (get, list): Any user can read risk level data.
     * @allow (create): User 'LXCCxs63v3YO0fVbqlUVuX7sa5P2' can create a risk level if request.auth.uid matches the document's 'ownerId' field.
     * @deny (create): User 'attackerUid' cannot create a risk level because their UID doesn't match the 'ownerId' field in the request.
     * @allow (update, delete): User 'LXCCxs63v3YO0fVbqlUVuX7sa5P2' can update/delete a risk level they own (resource.data.ownerId == request.auth.uid).
     * @deny (update, delete): User 'attackerUid' cannot update/delete a risk level owned by another user.
     * @principle Implements a public-read, owner-write access control pattern for risk levels.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create: if request.auth != null; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows anyone to read statuses, but only authenticated owners to create, update, or delete them.
     * @path /statuses/{statusId}
     * @allow (get, list): Any user can read status data.
     * @allow (create): User 'LXCCxs63v3YO0fVbqlUVuX7sa5P2' can create a status if request.auth.uid matches the document's 'ownerId' field.
     * @deny (create): User 'attackerUid' cannot create a status because their UID doesn't match the 'ownerId' field in the request.
     * @allow (update, delete): User 'LXCCxs63v3YO0fVbqlUVuX7sa5P2' can update/delete a status they own (resource.data.ownerId == request.auth.uid).
     * @deny (update, delete): User 'attackerUid' cannot update/delete a status owned by another user.
     * @principle Implements a public-read, owner-write access control pattern for statuses.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create: if request.auth != null; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows anyone to read findings, but only authenticated owners to create, update, or delete them.
     * @path /findings/{findingId}
     * @allow (get, list): Any user can read finding data.
     * @allow (create): User 'LXCCxs63v3YO0fVbqlUVuX7sa5P2' can create a finding if request.auth.uid matches the document's 'ownerId' field.
     * @deny (create): User 'attackerUid' cannot create a finding because their UID doesn't match the 'ownerId' field in the request.
     * @allow (update, delete): User 'LXCCxs63v3YO0fVbqlUVuX7sa5P2' can update/delete a finding they own (resource.data.ownerId == request.auth.uid).
     * @deny (update, delete): User 'attackerUid' cannot update/delete a finding owned by another user.
     * @principle Implements a public-read, owner-write access control pattern for findings.
     */
    match /findings/{findingId} {
      allow get, list: if true;
      allow create: if request.auth != null; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}