/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset provides secure but permissive access for rapid prototyping.
 * It prioritizes restricting unauthorized data access above strict data validation.
 * All collections are secured against unauthorized writes.
 *
 * Data Structure:
 * The Firestore database consists of several top-level collections: `branches`, `districts`, `riskLevels`, `statuses`, and `findings`.
 *
 * Key Security Decisions:
 * - **No User-Specific Data:** The application currently does not have user accounts.
 * - **Open Reads:** All collections are publicly readable to facilitate easy data exploration during development.
 * - **Write Restrictions:** Writes to all collections are denied by default.  Specific write rules must be added as development proceeds and authorization requirements are clarified.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the 'branches' collection.
     * @path /databases/{database}/documents/branches/{branchId}
     * @allow (get, list): Any user can read branch information.
     * @deny (create, update, delete): No one can create, update, or delete branches by default. This should be configured later with appropriate roles.
     * @principle Open reads, restricted writes.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to the 'districts' collection.
     * @path /databases/{database}/documents/districts/{districtId}
     * @allow (get, list): Any user can read district information.
     * @deny (create, update, delete): No one can create, update, or delete districts by default. This should be configured later with appropriate roles.
     * @principle Open reads, restricted writes.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to the 'riskLevels' collection.
     * @path /databases/{database}/documents/riskLevels/{riskLevelId}
     * @allow (get, list): Any user can read risk level information.
     * @deny (create, update, delete): No one can create, update, or delete risk levels by default. This should be configured later with appropriate roles.
     * @principle Open reads, restricted writes.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to the 'statuses' collection.
     * @path /databases/{database}/documents/statuses/{statusId}
     * @allow (get, list): Any user can read status information.
     * @deny (create, update, delete): No one can create, update, or delete statuses by default. This should be configured later with appropriate roles.
     * @principle Open reads, restricted writes.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to the 'findings' collection.
     * @path /databases/{database}/documents/findings/{findingId}
     * @allow (get, list): Any user can read audit finding information.
     * @deny (create, update, delete): No one can create, update, or delete findings by default. This should be configured later with appropriate roles.
     * @principle Open reads, restricted writes.
     */
    match /findings/{findingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}