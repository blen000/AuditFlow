/**
 * @fileOverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset is designed for the rapid prototyping phase of application development.
 * It prioritizes ease of use and quick iteration, while still providing a baseline level of security.
 * All collections are publicly readable. Writes are disallowed for all users.
 *
 * Data Structure:
 * The Firestore database consists of a flat structure with top-level collections for
 * branches, districts, riskLevels, statuses, and findings.
 *
 * Key Security Decisions:
 * - Public Read Access: All data is readable by any user, including unauthenticated users.
 * - Write Restrictions: No user is allowed to create, update, or delete any data.
 * - Data Validation: Data validation is minimized to allow for flexible schema changes during prototyping.
 *   However, basic authorization-related checks are still enforced.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to branches, but denies all writes.
     * @path /branches/{branchId}
     * @allow (get, list): Any user can read branch data.
     * @deny (create, update, delete): No user can modify branch data.
     * @principle Allows public read access and restricts all write access.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to districts, but denies all writes.
     * @path /districts/{districtId}
     * @allow (get, list): Any user can read district data.
     * @deny (create, update, delete): No user can modify district data.
     * @principle Allows public read access and restricts all write access.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to risk levels, but denies all writes.
     * @path /riskLevels/{riskLevelId}
     * @allow (get, list): Any user can read risk level data.
     * @deny (create, update, delete): No user can modify risk level data.
     * @principle Allows public read access and restricts all write access.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to statuses, but denies all writes.
     * @path /statuses/{statusId}
     * @allow (get, list): Any user can read status data.
     * @deny (create, update, delete): No user can modify status data.
     * @principle Allows public read access and restricts all write access.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to findings, but denies all writes.
     * @path /findings/{findingId}
     * @allow (get, list): Any user can read finding data.
     * @deny (create, update, delete): No user can modify finding data.
     * @principle Allows public read access and restricts all write access.
     */
    match /findings/{findingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}