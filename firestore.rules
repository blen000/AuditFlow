/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a public-read, owner-write model for the top-level collections: `branches`, `districts`, `riskLevels`, `statuses`, and `findings`.
 *
 * Data Structure:
 * - /branches/{branchId}: Stores branch data.
 * - /districts/{districtId}: Stores district data.
 * - /riskLevels/{riskLevelId}: Stores risk level data.
 * - /statuses/{statusId}: Stores status data.
 * - /findings/{findingId}: Stores audit finding data.
 *
 * Key Security Decisions:
 * - Public Read: All `get` and `list` operations are allowed for all users, including unauthenticated users.
 * - Owner-Only Writes: `create`, `update`, and `delete` operations are restricted to the owner of the document, based on an `ownerId` field.
 * - Missing Ownership Field: The current data model lacks an `ownerId` or `authorId` field in several entities.  Placeholder rules with `TODO` comments are added where owner-only writes are intended but cannot be enforced.
 * - No User Listing: There are no user-specific collections or subcollections, so user listing is not applicable.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read branch data, but restricts writes to the owner.
     * @path /branches/{branchId}
     * @allow (get, list): Any user can read branch data.
     * @allow (create, update, delete): Only the owner of the branch can modify it. The document must contain an `ownerId` field.
     * @deny (create, update, delete): If the document does not contain a valid `ownerId`, or if the user is not the owner.
     * @principle Public read, owner-only writes.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows anyone to read district data, but restricts writes to the owner.
     * @path /districts/{districtId}
     * @allow (get, list): Any user can read district data.
     * @allow (create, update, delete): Only the owner of the district can modify it. The document must contain an `ownerId` field.
     * @deny (create, update, delete): If the document does not contain a valid `ownerId`, or if the user is not the owner.
     * @principle Public read, owner-only writes.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows anyone to read risk level data, but restricts writes to the owner.
     * @path /riskLevels/{riskLevelId}
     * @allow (get, list): Any user can read risk level data.
     * @allow (create, update, delete): Only the owner of the risk level can modify it. The document must contain an `ownerId` field.
     * @deny (create, update, delete): If the document does not contain a valid `ownerId`, or if the user is not the owner.
     * @principle Public read, owner-only writes.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows anyone to read status data, but restricts writes to the owner.
     * @path /statuses/{statusId}
     * @allow (get, list): Any user can read status data.
     * @allow (create, update, delete): Only the owner of the status can modify it. The document must contain an `ownerId` field.
     * @deny (create, update, delete): If the document does not contain a valid `ownerId`, or if the user is not the owner.
     * @principle Public read, owner-only writes.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows anyone to read audit finding data, but restricts writes to the owner.
     * @path /findings/{findingId}
     * @allow (get, list): Any user can read audit finding data.
     * @allow (create, update, delete): Only the owner of the audit finding can modify it. The document must contain an `ownerId` field.
     * @deny (create, update, delete): If the document does not contain a valid `ownerId`, or if the user is not the owner.
     * @principle Public read, owner-only writes.
     */
    match /findings/{findingId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}