/**
 * @fileOverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset is in prototyping mode. It focuses on authorization but relaxes data validation to allow for rapid schema iteration.
 * All collections are publicly readable to facilitate exploration and initial development.
 * Write access (create, update, delete) is strictly controlled to prevent unauthorized data manipulation.
 *
 * Data Structure:
 * The database consists of top-level collections for `branches`, `districts`, `riskLevels`, `statuses`, and `findings`. There are no user-specific subcollections in this initial prototype.
 *
 * Key Security Decisions:
 * - Public Read Access: All collections are publicly readable (`get`, `list`). This simplifies initial development.
 * - Write Restrictions: `create`, `update`, and `delete` operations are **always** restricted and require authentication to prevent unauthorized modification of the data.
 * - No User Listing: Listing all users is not supported.
 * - Denormalization Recommended: For simpler security rules and improved performance, denormalize authorization-related data (e.g., owner IDs, role lists) directly onto documents. This avoids costly `get()` operations in the rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read branch information, but requires authentication to create, update, or delete a branch.
     * @path /databases/{database}/documents/branches/{branchId}
     * @allow (get, list): Any user can read branch data.
     * @allow (create): Authenticated user can create a new branch.
     * @allow (update): Authenticated user can update an existing branch.
     * @allow (delete): Authenticated user can delete an existing branch.
     * @deny (create): Unauthenticated user cannot create a branch.
     * @deny (update): Unauthenticated user cannot update a branch.
     * @deny (delete): Unauthenticated user cannot delete a branch.
     * @principle Allows public reads, enforces authentication for writes.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows anyone to read district information, but requires authentication to create, update, or delete a district.
     * @path /databases/{database}/documents/districts/{districtId}
     * @allow (get, list): Any user can read district data.
     * @allow (create): Authenticated user can create a new district.
     * @allow (update): Authenticated user can update an existing district.
     * @allow (delete): Authenticated user can delete an existing district.
     * @deny (create): Unauthenticated user cannot create a district.
     * @deny (update): Unauthenticated user cannot update a district.
     * @deny (delete): Unauthenticated user cannot delete a district.
     * @principle Allows public reads, enforces authentication for writes.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows anyone to read risk level information, but requires authentication to create, update, or delete a risk level.
     * @path /databases/{database}/documents/riskLevels/{riskLevelId}
     * @allow (get, list): Any user can read risk level data.
     * @allow (create): Authenticated user can create a new risk level.
     * @allow (update): Authenticated user can update an existing risk level.
     * @allow (delete): Authenticated user can delete an existing risk level.
     * @deny (create): Unauthenticated user cannot create a risk level.
     * @deny (update): Unauthenticated user cannot update a risk level.
     * @deny (delete): Unauthenticated user cannot delete a risk level.
     * @principle Allows public reads, enforces authentication for writes.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows anyone to read status information, but requires authentication to create, update, or delete a status.
     * @path /databases/{database}/documents/statuses/{statusId}
     * @allow (get, list): Any user can read status data.
     * @allow (create): Authenticated user can create a new status.
     * @allow (update): Authenticated user can update an existing status.
     * @allow (delete): Authenticated user can delete an existing status.
     * @deny (create): Unauthenticated user cannot create a status.
     * @deny (update): Unauthenticated user cannot update a status.
     * @deny (delete): Unauthenticated user cannot delete a status.
     * @principle Allows public reads, enforces authentication for writes.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows anyone to read audit finding information, but requires authentication to create, update, or delete a finding.
     * @path /databases/{database}/documents/findings/{findingId}
     * @allow (get, list): Any user can read finding data.
     * @allow (create): Authenticated user can create a new audit finding.
     * @allow (update): Authenticated user can update an existing audit finding.
     * @allow (delete): Authenticated user can delete an existing audit finding.
     * @deny (create): Unauthenticated user cannot create a finding.
     * @deny (update): Unauthenticated user cannot update a finding.
     * @deny (delete): Unauthenticated user cannot delete a finding.
     * @principle Allows public reads, enforces authentication for writes.
     */
    match /findings/{findingId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }
  }

  // Helper function to determine if a user is signed in.
  function isSignedIn() {
    return request.auth != null;
  }
}