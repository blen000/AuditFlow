/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset allows public read access to all collections, while restricting write access to prevent unauthorized data modification. Since authentication is anonymous, there is no way to restrict the write access to a specific user.
 * @data_structure The Firestore database consists of several top-level collections: 'branches', 'districts', 'riskLevels', 'statuses', and 'findings'. Each collection contains documents representing entities like bank branches, organizational districts, risk levels, audit statuses, and audit findings, respectively.
 * @key_security_decisions
 *   - Public Read Access: All `get` and `list` operations are allowed for all users (including unauthenticated users).
 *   - Unrestricted Writes: Since auth is anonymous, write access is not restricted.
 *   - No User Listing: User listing is not possible as authentication is anonymous.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read branches, but write operations are open.
     * @path /branches/{branchId}
     * @allow (get, list) Any user can read the branches.
     * @allow (create, update, delete) Any user can write to the branches.
     * @deny None
     * @principle Allows public read access while writes are open due to anonymous authentication.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read districts, but write operations are open.
     * @path /districts/{districtId}
     * @allow (get, list) Any user can read the districts.
     * @allow (create, update, delete) Any user can write to the districts.
     * @deny None
     * @principle Allows public read access while writes are open due to anonymous authentication.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read riskLevels, but write operations are open.
     * @path /riskLevels/{riskLevelId}
     * @allow (get, list) Any user can read the riskLevels.
     * @allow (create, update, delete) Any user can write to the riskLevels.
     * @deny None
     * @principle Allows public read access while writes are open due to anonymous authentication.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read statuses, but write operations are open.
     * @path /statuses/{statusId}
     * @allow (get, list) Any user can read the statuses.
     * @allow (create, update, delete) Any user can write to the statuses.
     * @deny None
     * @principle Allows public read access while writes are open due to anonymous authentication.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows anyone to read findings, but write operations are open.
     * @path /findings/{findingId}
     * @allow (get, list) Any user can read the findings.
     * @allow (create, update, delete) Any user can write to the findings.
     * @deny None
     * @principle Allows public read access while writes are open due to anonymous authentication.
     */
    match /findings/{findingId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}