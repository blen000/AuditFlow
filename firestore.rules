/**
 * @file Firestore Security Rules
 * @description This ruleset allows public read access to lookup collections
 * (branches, districts, riskLevels, statuses) and open access to audit findings.
 *
 * Data Structure:
 * - /branches/{branchId}: Stores bank branch data.
 * - /districts/{districtId}: Stores organizational district data.
 * - /riskLevels/{riskLevelId}: Stores risk level data.
 * - /statuses/{statusId}: Stores status data.
 * - /findings/{findingId}: Stores audit finding data.
 *
 * Key Security Decisions:
 * - Read-only access to branches, districts, riskLevels and statuses collections.
 * - No authentication required due to the usage of anonymous authentication.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to bank branch documents.
     * @path /branches/{branchId}
     * @allow (get, list) Any user can read branch information.
     * @deny (create, update, delete) No user can create, update, or delete branch documents.
     * @principle Public read access for lookup data.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to organizational district documents.
     * @path /districts/{districtId}
     * @allow (get, list) Any user can read district information.
     * @deny (create, update, delete) No user can create, update, or delete district documents.
     * @principle Public read access for lookup data.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to risk level documents.
     * @path /riskLevels/{riskLevelId}
     * @allow (get, list) Any user can read risk level information.
     * @deny (create, update, delete) No user can create, update, or delete risk level documents.
     * @principle Public read access for lookup data.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to status documents.
     * @path /statuses/{statusId}
     * @allow (get, list) Any user can read status information.
     * @deny (create, update, delete) No user can create, update, or delete status documents.
     * @principle Public read access for lookup data.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants open access to audit findings documents.
     * @path /findings/{findingId}
     * @allow (get, list, create, update, delete) Any user can read or write audit finding information.
     * @principle Open access for audit findings.
     */
    match /findings/{findingId} {
      allow get, list, create, update, delete: if true;
    }
  }
}