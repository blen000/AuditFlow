/**
 * @file Overview
 * This ruleset provides open read access to all collections to support rapid prototyping,
 * while strictly prohibiting any write operations. This approach allows developers
 * to quickly populate and view data in the application without implementing detailed
 * authorization logic during the initial development phase.
 *
 * Data Structure:
 * - The database contains top-level collections for branches, districts, risk levels,
 *   statuses, and audit findings. There is no user-specific data or hierarchy.
 *
 * Key Security Decisions:
 * - Read-only access for all collections (branches, districts, riskLevels, statuses, findings).
 *   This decision is made to facilitate easy data viewing during the prototyping phase.
 * - All write operations (create, update, delete) are strictly denied.
 * - No user-based or role-based access control is implemented at this stage.
 * - Data validation is not enforced, allowing for flexible schema evolution.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read branch data, but prohibits all write operations.
     * @path /branches/{branchId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows open reads for prototyping while preventing unauthorized data modification.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read district data, but prohibits all write operations.
     * @path /districts/{districtId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows open reads for prototyping while preventing unauthorized data modification.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read risk level data, but prohibits all write operations.
     * @path /riskLevels/{riskLevelId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows open reads for prototyping while preventing unauthorized data modification.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read status data, but prohibits all write operations.
     * @path /statuses/{statusId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows open reads for prototyping while preventing unauthorized data modification.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read audit finding data, but prohibits all write operations.
     * @path /findings/{findingId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows open reads for prototyping while preventing unauthorized data modification.
     */
    match /findings/{findingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}