/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a public read-only model for core organizational data (branches, districts, risk levels, statuses)
 * and open access to audit findings. No authentication is required.
 *
 * Data Structure:
 * - /branches/{branchId}: Stores branch information.
 * - /districts/{districtId}: Stores district information.
 * - /riskLevels/{riskLevelId}: Stores risk level information.
 * - /statuses/{statusId}: Stores status information.
 * - /findings/{findingId}: Stores audit findings.
 *
 * Key Security Decisions:
 * - Public Read Access: All `get` and `list` operations are allowed for all users, including unauthenticated users.
 * - Open Write Access: All `create`, `update` and `delete` operations are allowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to branches. Write operations are allowed.
     * @path /branches/{branchId}
     * @allow (get, list) - Any user, authenticated or not, can read branch information.
     * @allow (create, update, delete) - Any user, authenticated or not, can write branch information.
     * @deny (none) - No requests are explicitly denied.
     * @principle Allows public read access to branches and allows any user to write branch information.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows public read access to districts. Write operations are allowed.
     * @path /districts/{districtId}
     * @allow (get, list) - Any user, authenticated or not, can read district information.
     * @allow (create, update, delete) - Any user, authenticated or not, can write district information.
     * @deny (none) - No requests are explicitly denied.
     * @principle Allows public read access to districts and allows any user to write district information.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows public read access to risk levels. Write operations are allowed.
     * @path /riskLevels/{riskLevelId}
     * @allow (get, list) - Any user, authenticated or not, can read risk level information.
     * @allow (create, update, delete) - Any user, authenticated or not, can write risk level information.
     * @deny (none) - No requests are explicitly denied.
     * @principle Allows public read access to risk levels and allows any user to write risk level information.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows public read access to statuses. Write operations are allowed.
     * @path /statuses/{statusId}
     * @allow (get, list) - Any user, authenticated or not, can read status information.
     * @allow (create, update, delete) - Any user, authenticated or not, can write status information.
     * @deny (none) - No requests are explicitly denied.
     * @principle Allows public read access to statuses and allows any user to write status information.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows public read access to audit findings. Write operations are allowed.
     * @path /findings/{findingId}
     * @allow (get, list) - Any user, authenticated or not, can read audit findings.
     * @allow (create, update, delete) - Any user, authenticated or not, can write audit findings.
     * @deny (none) - No requests are explicitly denied.
     * @principle Allows public read access to audit findings and allows any user to write audit findings.
     */
    match /findings/{findingId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}