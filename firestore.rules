/**
 * @description This ruleset enforces a public read policy for lookup collections,
 *              allowing any user (signed in or not) to read the data. Write
 *              access is denied to prevent unauthorized modifications.
 * @dataStructure The database contains flat collections for lookup data
 *                (riskLevels, statuses, districts, branches) and a main
 *                'findings' collection. There is no user-specific data.
 * @keySecurityDecisions All lookup collections are publicly readable. Writes
 *                       are forbidden to all collections to prevent unauthorized changes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read the list of risk levels, but nobody to modify it.
     * @path /databases/{database}/documents/riskLevels/{riskLevelId}
     * @allow (get, list) Anyone can read the data.
     * @deny (create, update, delete) No one can modify the data.
     * @principle Allows public read access to risk levels.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read the list of statuses, but nobody to modify it.
     * @path /databases/{database}/documents/statuses/{statusId}
     * @allow (get, list) Anyone can read the data.
     * @deny (create, update, delete) No one can modify the data.
     * @principle Allows public read access to statuses.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read the list of districts, but nobody to modify it.
     * @path /databases/{database}/documents/districts/{districtId}
     * @allow (get, list) Anyone can read the data.
     * @deny (create, update, delete) No one can modify the data.
     * @principle Allows public read access to districts.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read the list of branches, but nobody to modify it.
     * @path /databases/{database}/documents/branches/{branchId}
     * @allow (get, list) Anyone can read the data.
     * @deny (create, update, delete) No one can modify the data.
     * @principle Allows public read access to branches.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
        /**
     * @description Denies access to all operations on findings. This is a placeholder.
     * @path /databases/{database}/documents/findings/{findingId}
     * @allow None
     * @deny All operations are denied until access is properly configured.
     * @principle Restricts all access to findings.
     */
    match /findings/{findingId} {
      allow get, list, create, update, delete: if false;
    }
  }
}