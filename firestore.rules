/**
 * @fileOverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset is designed for the rapid prototyping phase of application development.
 * It prioritizes ease of use and quick iteration, focusing on basic authorization
 * without strict schema validation.  All collections are globally readable, but
 * writes are disallowed. This enables quick UI development against live data.
 *
 * Data Structure:
 * The Firestore database consists of several top-level collections: `branches`,
 * `districts`, `riskLevels`, `statuses`, and `findings`. Each collection stores
 * documents representing the corresponding entities.
 *
 * Key Security Decisions:
 * - **Global Read Access:** All collections are readable by anyone, including
 *   unauthenticated users. This simplifies initial development and data exploration.
 * - **Write Protection:** All write operations (create, update, delete) are
 *   disabled. This prevents accidental data modification during development.
 * - **No Schema Validation:** The rules do not enforce strict schema validation.
 *   This allows for flexible data structures and faster iteration, but it's
 *   crucial to add proper validation before production deployment.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read branches, but denies all writes.
     * @path /databases/{database}/documents/branches/{branchId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public read access for prototyping.
     */
    match /branches/{branchId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read districts, but denies all writes.
     * @path /databases/{database}/documents/districts/{districtId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public read access for prototyping.
     */
    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read riskLevels, but denies all writes.
     * @path /databases/{database}/documents/riskLevels/{riskLevelId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public read access for prototyping.
     */
    match /riskLevels/{riskLevelId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read statuses, but denies all writes.
     * @path /databases/{database}/documents/statuses/{statusId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public read access for prototyping.
     */
    match /statuses/{statusId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read findings, but denies all writes.
     * @path /databases/{database}/documents/findings/{findingId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows public read access for prototyping.
     */
    match /findings/{findingId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}