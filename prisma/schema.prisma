generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String           @id @default(cuid())
  fullName              String
  email                 String           @unique
  password              String
  roleId                String
  status                String           @default("Active")
  branch                String?
  district              String?
  dateJoined            DateTime         @default(now())
  requirePasswordChange Boolean          @default(true)
  passwordLastChanged   DateTime         @default(now())
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  uploads               FileAttachment[]
  sessions              Session[]
  role                  Role             @relation(fields: [roleId], references: [id])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  fingerprint  String?
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  permissions String[]
  isSpecial   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}

model Department {
  id   String @id @default(cuid())
  name String @unique
}

model RiskLevel {
  id   String @id @default(cuid())
  name String @unique
}

model FindingStatus {
  id   String @id @default(cuid())
  name String @unique
}

model FollowUpStatus {
  id   String @id @default(cuid())
  name String @unique
}

model SpecialFindingCategory {
  id     String         @id @default(cuid())
  name   String         @unique
  audits SpecialAudit[]
}

model AuditHierarchyNode {
  id           String               @id @default(cuid())
  parentId     String?
  level        Int
  number       String               @unique
  title        String
  customFields Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  findings     AuditFinding[]
  parent       AuditHierarchyNode?  @relation("HierarchyTree", fields: [parentId], references: [id])
  children     AuditHierarchyNode[] @relation("HierarchyTree")
}

model AuditFinding {
  id                        String             @id @default(cuid())
  title                     String
  details                   String
  riskLevel                 String
  branchOrDepartment        String
  recommendation            String
  status                    String             @default("Open")
  auditeeAgreement          String             @default("Pending")
  auditCause                String?
  auditEffect               String?
  involvedAmounts           Json?
  involvedCases             Json?
  teamLeader                String?
  teamMembers               Json?
  assignedDate              DateTime?
  dateCommunicated          DateTime?
  finalizationDate          DateTime?
  tatDays                   Int?               @default(15)
  revalidationDate          DateTime?
  mitigationDueDate         DateTime?
  auditeeResponse           String?
  auditeeAttachmentFilename String?
  progressUpdates           Json?
  dynamicValues             Json?
  verbalComm                Json?
  writtenComm               Json?
  esc1                      Json?
  esc2                      Json?
  followUpRecommendations   String?
  forwardingHistory         Json?
  collaboratingWith         String?
  hierarchyNodeId           String
  isClosed                  Boolean            @default(false)
  followUpStatus            String?            @default("Pending")
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  hierarchyNode             AuditHierarchyNode @relation(fields: [hierarchyNodeId], references: [id])
  attachments               FileAttachment[]
}

model FileAttachment {
  id           String        @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  uploaderId   String
  findingId    String?
  category     String?
  createdAt    DateTime      @default(now())
  finding      AuditFinding? @relation(fields: [findingId], references: [id])
  uploader     User          @relation(fields: [uploaderId], references: [id])
}

model SpecialAudit {
  id                    String                   @id @default(cuid())
  shortSummary          String
  placement             String
  placementValue        String
  categoryId            String?
  amountInvolved        Float
  recovered             Float
  pending               Float
  actionDisciplinary    String
  gapWitnessed          String
  correctiveActionTaken String
  auditCause            String?
  auditEffect           String?
  recommendation        String?
  dateCreated           DateTime                 @default(now())
  category              SpecialFindingCategory?  @relation(fields: [categoryId], references: [id])
  individuals           SpecialAuditIndividual[]
}

model SpecialAuditIndividual {
  id             String       @id @default(cuid())
  name           String
  position       String
  tenure         String
  age            Int
  sex            String
  specialAuditId String
  specialAudit   SpecialAudit @relation(fields: [specialAuditId], references: [id], onDelete: Cascade)
}

model SecurityAuditLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  eventType    String
  severity     String
  userId       String?
  email        String?
  action       String
  details      String?
  ipAddress    String?
  userAgent    String?
  resourceId   String?
  resourceType String?

  @@index([eventType])
  @@index([userId])
  @@index([timestamp])
}

model LoginAttempt {
  id            String    @id @default(cuid())
  identifier    String    // Email or IP address
  attempts      Int       @default(0)
  lockedUntil   DateTime?
  lastAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([identifier])
}
