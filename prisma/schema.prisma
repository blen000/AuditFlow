generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  isSpecial   Boolean  @default(false)
  users       User[]
}

model User {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  status     String   @default("Active")
  dateJoined DateTime @default(now())
  branch     String?
  district   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}

model AuditHierarchyNode {
  id           String               @id @default(cuid())
  parentId     String?
  parent       AuditHierarchyNode?  @relation("SubNodes", fields: [parentId], references: [id])
  children     AuditHierarchyNode[] @relation("SubNodes")
  level        Int
  number       String
  title        String
  customFields Json? // Array of {id, name, type}
  findings     AuditFinding[]
}

model AuditFinding {
  id                 String             @id @default(cuid())
  title              String
  details            String
  riskLevel          String
  branchOrDepartment String
  recommendation     String
  status             String
  revalidationDate   DateTime?
  auditeeAgreement   String             @default("Pending")
  mitigationDueDate  DateTime?
  auditeeResponse    String?
  progressUpdates    Json?              // Array of {id, date, details, attachmentFilename}
  involvedAmounts    Json?              // Array of {name, amount}
  involvedCases      Json?              // Array of {id, ownerName, status}
  teamLeader         String
  teamMembers        String[]
  assignedDate       DateTime?
  dateCommunicated   DateTime?
  finalizationDate   DateTime?
  tatDays            Int?
  followUpStatus     String?
  followUpRecommendations String?
  isClosed           Boolean            @default(false)
  hierarchyNodeId    String
  hierarchyNode      AuditHierarchyNode @relation(fields: [hierarchyNodeId], references: [id])
  dynamicValues      Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model SpecialAudit {
  id                    String                   @id @default(cuid())
  shortSummary          String
  placement             String
  placementValue        String
  amountInvolved        Float
  recovered             Float
  pending               Float
  actionDisciplinary    String
  gapWitnessed          String
  correctiveActionTaken String
  auditCause            String?
  auditEffect           String?
  recommendation        String?
  dateCreated           DateTime                 @default(now())
  individuals           SpecialAuditIndividual[]
}

model SpecialAuditIndividual {
  id             String       @id @default(cuid())
  specialAuditId String
  specialAudit   SpecialAudit @relation(fields: [specialAuditId], references: [id], onDelete: Cascade)
  name           String
  position       String
  tenure         String
  age            Int
  sex            String
}

model RiskLevel {
  id   String @id @default(cuid())
  name String @unique
}

model FindingStatus {
  id   String @id @default(cuid())
  name String @unique
}

model Department {
  id   String @id @default(cuid())
  name String @unique
}
