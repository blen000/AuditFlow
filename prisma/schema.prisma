// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  fullName      String
  email         String   @unique
  password      String
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id])
  status        String   @default("Active")
  branch        String?
  district      String?
  dateJoined    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  permissions String[]
  isSpecial   Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}

model Department {
  id   String @id @default(cuid())
  name String @unique
}

model RiskLevel {
  id   String @id @default(cuid())
  name String @unique
}

model FindingStatus {
  id   String @id @default(cuid())
  name String @unique
}

model AuditHierarchyNode {
  id           String               @id @default(cuid())
  parentId     String?
  parent       AuditHierarchyNode?  @relation("HierarchyTree", fields: [parentId], references: [id])
  children     AuditHierarchyNode[] @relation("HierarchyTree")
  level        Int
  number       String               @unique
  title        String
  customFields Json?                // Array of CustomFieldDefinition
  findings     AuditFinding[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model AuditFinding {
  id                String   @id @default(cuid())
  title             String   // Title from the hierarchy node at time of creation
  details           String
  riskLevel         String
  branchOrDepartment String
  recommendation    String
  status            String   @default("Open")
  auditeeAgreement  String   @default("Pending")
  
  auditCause        String?
  auditEffect       String?
  
  involvedAmounts   Json?    // Array of InvolvedAmount
  involvedCases     Json?    // Array of InvolvedCase
  
  teamLeader        String?
  teamMembers       Json?    // Array of strings
  
  assignedDate      DateTime?
  dateCommunicated  DateTime?
  finalizationDate  DateTime?
  tatDays           Int?     @default(15)
  
  revalidationDate  DateTime?
  mitigationDueDate DateTime?
  auditeeResponse   String?
  auditeeAttachmentFilename String?
  
  progressUpdates   Json?    // Array of ProgressUpdate
  dynamicValues     Json?    // Key-value pairs for node-specific fields
  
  hierarchyNodeId   String
  hierarchyNode     AuditHierarchyNode @relation(fields: [hierarchyNodeId], references: [id])
  
  isClosed          Boolean  @default(false)
  followUpStatus    String?  @default("Pending")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SpecialAudit {
  id                    String   @id @default(cuid())
  shortSummary          String
  placement             String
  placementValue        String
  amountInvolved        Float
  recovered             Float
  pending               Float
  actionDisciplinary    String
  gapWitnessed          String
  correctiveActionTaken String
  auditCause            String?
  auditEffect           String?
  recommendation        String?
  dateCreated           DateTime @default(now())
  individuals           SpecialAuditIndividual[]
}

model SpecialAuditIndividual {
  id             String       @id @default(cuid())
  name           String
  position       String
  tenure         String
  age            Int
  sex            String
  specialAuditId String
  specialAudit   SpecialAudit @relation(fields: [specialAuditId], references: [id], onDelete: Cascade)
}
