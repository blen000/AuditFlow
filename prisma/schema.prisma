// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  permissions String[]
  isSpecial   Boolean  @default(false)
  users       User[]
}

model User {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  status     String   @default("Active")
  dateJoined DateTime @default(now())
  branch     String?
  district   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}

model Department {
  id   String @id @default(cuid())
  name String @unique
}

model RiskLevel {
  id   String @id @default(cuid())
  name String @unique
}

model FindingStatus {
  id   String @id @default(cuid())
  name String @unique
}

model AuditHierarchyNode {
  id           String               @id @default(cuid())
  parentId     String?
  parent       AuditHierarchyNode?  @relation("HierarchyNesting", fields: [parentId], references: [id])
  children     AuditHierarchyNode[] @relation("HierarchyNesting")
  level        Int
  number       String
  title        String
  customFields Json?                @default("[]") // Array of CustomFieldDefinition
  findings     AuditFinding[]
}

model AuditFinding {
  id                         String             @id @default(cuid())
  hierarchyNodeId            String
  hierarchyNode              AuditHierarchyNode @relation(fields: [hierarchyNodeId], references: [id])
  title                      String
  category                   String?
  details                    String
  riskLevel                  String
  branchOrDepartment         String
  auditType                  String?
  recommendation             String
  status                     String
  revalidationDate           DateTime?
  auditeeAgreement           String             @default("Pending")
  mitigationDueDate          DateTime?
  auditeeResponse            String?
  progressUpdates            Json?              @default("[]")
  involvedAmounts            Json?              @default("[]")
  involvedCases              Json?              @default("[]")
  teamLeader                 String
  teamMembers                String[]
  assignedDate               DateTime?
  dateCommunicated           DateTime?
  finalizationDate           DateTime?
  tatDays                    Int?
  followUpStatus             String?            @default("Pending")
  verbalComm                 Json?              @default("[]")
  writtenComm                Json?              @default("[]")
  esc1                       Json?              @default("[]")
  esc2                       Json?              @default("[]")
  followUpRecommendations    String?
  isClosed                   Boolean            @default(false)
  collaboratingWith          String?
  forwardingHistory          Json?              @default("[]")
  dynamicValues              Json?              @default("{}")
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
}

model SpecialAudit {
  id                    String                   @id @default(cuid())
  shortSummary          String
  placement             String // Branch, District, H.O
  placementValue        String
  amountInvolved        Float
  recovered             Float
  pending               Float
  individuals           SpecialAuditIndividual[]
  actionDisciplinary    String
  gapWitnessed          String
  correctiveActionTaken String
  auditCause            String?
  auditEffect           String?
  recommendation        String?
  dateCreated           DateTime                 @default(now())
}

model SpecialAuditIndividual {
  id             String       @id @default(cuid())
  specialAuditId String
  specialAudit   SpecialAudit @relation(fields: [specialAuditId], references: [id], onDelete: Cascade)
  name           String
  position       String
  tenure         String
  age            Int
  sex            String
}
