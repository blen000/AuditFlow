// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  permissions String[]
  isSpecial   Boolean  @default(false)
  users       User[]
}

model User {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  password   String
  role       Role     @relation(fields: [roleId], references: [id])
  roleId     String
  status     String   @default("Active")
  dateJoined DateTime @default(now())
  branch     String?
  district   String?
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  district   District @relation(fields: [districtId], references: [id])
  districtId String
}

model Department {
  id   String @id @default(cuid())
  name String @unique
}

model RiskLevel {
  id   String @id @default(cuid())
  name String @unique
}

model FindingStatus {
  id   String @id @default(cuid())
  name String @unique
}

model AuditHierarchyNode {
  id           String               @id @default(cuid())
  parentId     String?
  parent       AuditHierarchyNode?  @relation("HierarchyTree", fields: [parentId], references: [id])
  children     AuditHierarchyNode[] @relation("HierarchyTree")
  level        Int
  number       String               @unique
  title        String
  customFields Json?                // Array of CustomFieldDefinition
}

model AuditFinding {
  id                        String   @id @default(cuid())
  parentCaseNumber          String
  parentSummary             String
  subsectionId              String?
  subsectionTitle           String?
  title                     String
  details                   String
  riskLevel                 String
  branchOrDepartment        String
  auditType                 String   @default("Branch")
  recommendation            String
  status                    String
  revalidationDate          DateTime?
  auditeeAgreement          String   @default("Pending")
  mitigationDueDate         DateTime?
  auditeeResponse           String?
  auditeeAttachmentFilename String?
  progressUpdates           Json?    // Array of ProgressUpdate
  findingAttachments        String[]
  recommendationAttachments  String[]
  auditCause                String?
  auditCauseAttachments     String[]
  auditEffect               String?
  auditEffectAttachments    String[]
  involvedAmounts           Json?    // Array of InvolvedAmount
  involvedCases             Json?    // Array of InvolvedCase
  teamLeader                String
  teamMembers               String[]
  assignedDate              DateTime? @default(now())
  dateCommunicated          DateTime?
  finalizationDate          DateTime?
  tatDays                   Int?      @default(15)
  followUpStatus            String?   @default("Pending")
  verbalComm                Json?     // Array of CommunicationEntry
  writtenComm               Json?     // Array of CommunicationEntry
  esc1                      Json?     // Array of CommunicationEntry
  esc2                      Json?     // Array of CommunicationEntry
  followUpRecommendations   String?
  isClosed                  Boolean   @default(false)
  collaboratingWith         String?
  forwardingHistory         Json?     // Array of ForwardingEntry
  hierarchyNodeId           String?
  dynamicValues             Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model SpecialAudit {
  id                    String                   @id @default(cuid())
  shortSummary          String
  placement             String
  placementValue        String
  amountInvolved        Float
  recovered             Float
  pending               Float
  actionDisciplinary    String
  gapWitnessed          String
  correctiveActionTaken String
  auditCause            String?
  auditEffect           String?
  recommendation        String?
  dateCreated           DateTime                 @default(now())
  individuals           SpecialAuditIndividual[]
}

model SpecialAuditIndividual {
  id             String       @id @default(cuid())
  name           String
  position       String
  tenure         String
  age            Int
  sex            String
  specialAudit   SpecialAudit @relation(fields: [specialAuditId], references: [id], onDelete: Cascade)
  specialAuditId String
}
