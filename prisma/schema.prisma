generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  permissions String[]
  isSpecial   Boolean  @default(false)
  users       User[]
}

model User {
  id         String   @id @default(uuid())
  fullName   String
  email      String   @unique
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  status     String   @default("Active")
  dateJoined DateTime @default(now())
  branch     String?
  district   String?
}

model District {
  id       String   @id @default(uuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(uuid())
  name       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}

model Department {
  id   String @id @default(uuid())
  name String @unique
}

model Chief {
  id   String @id @default(uuid())
  name String @unique
}

model CEO {
  id   String @id @default(uuid())
  name String @unique
}

model Board {
  id   String @id @default(uuid())
  name String @unique
}

model RiskLevel {
  id   String @id @default(uuid())
  name String @unique
}

model FindingStatus {
  id   String @id @default(uuid())
  name String @unique
}

model Auditor {
  id       String @id @default(uuid())
  fullName String
  email    String @unique
  phone    String
}

model AuditHierarchyNode {
  id           String               @id @default(uuid())
  parentId     String?
  parent       AuditHierarchyNode?  @relation("Hierarchy", fields: [parentId], references: [id])
  children     AuditHierarchyNode[] @relation("Hierarchy")
  level        Int
  number       String
  title        String
  customFields Json? // Array of { id, name, type }
  findings     AuditFinding[]
}

model AuditFinding {
  id                      String             @id @default(uuid())
  hierarchyNodeId         String
  hierarchyNode           AuditHierarchyNode @relation(fields: [hierarchyNodeId], references: [id])
  details                 String
  riskLevel               String
  branchOrDepartment      String
  status                  String
  revalidationDate        DateTime?
  auditeeAgreement        String             @default("Pending")
  mitigationDueDate       DateTime?
  auditeeResponse         String?
  auditCause              String?
  auditEffect             String?
  recommendation          String?
  teamLeader              String
  teamMembers             String[]
  assignedDate            DateTime?
  dateCommunicated        DateTime?
  finalizationDate        DateTime?
  tatDays                 Int?
  followUpStatus          String?            @default("Pending")
  followUpRecommendations String?
  isClosed                Boolean            @default(false)
  collaboratingWith       String?
  involvedAmounts         Json? // Array of { name, amount }
  involvedCases           Json? // Array of { id, ownerName, status }
  progressUpdates         Json? // Array of { id, date, details, attachmentFilename }
  verbalComm              Json? // Array of { date, meta }
  writtenComm             Json? // Array of { date, meta }
  esc1                    Json? // Array of { date, meta }
  esc2                    Json? // Array of { date, meta }
  forwardingHistory       Json? // Array of { id, from, to, date, comments }
  dynamicValues           Json? // Record<string, any>
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model SpecialAudit {
  id                    String   @id @default(uuid())
  shortSummary          String
  placement             String // Branch, District, H.O
  placementValue        String
  amountInvolved        Float
  recovered             Float
  pending               Float
  individuals           Json // Array of { name, position, tenure, age, sex }
  actionDisciplinary    String
  gapWitnessed          String
  correctiveActionTaken String
  auditCause            String?
  auditEffect           String?
  recommendation        String?
  dateCreated           DateTime @default(now())
}
