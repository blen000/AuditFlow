generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  permissions String[]
  isSpecial   Boolean  @default(false)
  users       User[]
}

model User {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  password   String?  
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  status     String   @default("Active")
  dateJoined DateTime @default(now())
  branch     String?
  district   String?
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}

model Department {
  id   String @id @default(cuid())
  name String @unique
}

model RiskLevel {
  id   String @id @default(cuid())
  name String @unique
}

model FindingStatus {
  id   String @id @default(cuid())
  name String @unique
}

model AuditHierarchyNode {
  id           String               @id @default(cuid())
  parentId     String?
  parent       AuditHierarchyNode?  @relation("HierarchyTree", fields: [parentId], references: [id])
  children     AuditHierarchyNode[] @relation("HierarchyTree")
  level        Int
  number       String               @unique
  title        String
  customFields Json?                @default("[]") 
  findings     AuditFinding[]
}

model AuditFinding {
  id                         String              @id @default(cuid())
  title                      String
  details                    String
  riskLevel                  String
  branchOrDepartment         String
  recommendation             String
  status                     String              @default("Open")
  revalidationDate           DateTime?
  auditeeAgreement           String              @default("Pending")
  mitigationDueDate          DateTime?
  auditeeResponse            String?
  auditeeAttachmentFilename  String?
  progressUpdates            Json?               @default("[]") 
  findingAttachments         String[]            @default([])
  recommendationAttachments   String[]            @default([])
  auditCause                 String?
  auditCauseAttachments      String[]            @default([])
  auditEffect                String?
  auditEffectAttachments     String[]            @default([])
  involvedAmounts            Json?               @default("[]") 
  involvedCases              Json?               @default("[]") 
  teamMembers                String[]            @default([])
  hierarchyNodeId            String?
  hierarchyNode              AuditHierarchyNode? @relation(fields: [hierarchyNodeId], references: [id])
  dynamicValues              Json?               @default("{}")
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  
  // KPI / Assignment tracking
  assignedDate               DateTime?
  finalizationDate           DateTime?
  tatDays                    Int?                @default(15)
  teamLeader                 String?
  auditType                  String?             @default("Branch")
  parentCaseNumber           String?
  parentSummary              String?
  subsectionId               String?
  subsectionTitle            String?
  followUpStatus             String?             @default("Pending")
  isClosed                   Boolean?            @default(false)
}

model SpecialAudit {
  id                    String                   @id @default(cuid())
  shortSummary          String
  placement             String                   
  placementValue        String
  amountInvolved        Float
  recovered             Float
  pending               Float
  actionDisciplinary    String
  gapWitnessed          String
  correctiveActionTaken String
  dateCreated           DateTime                 @default(now())
  individuals           SpecialAuditIndividual[]
}

model SpecialAuditIndividual {
  id             String       @id @default(cuid())
  specialAuditId String
  specialAudit   SpecialAudit @relation(fields: [specialAuditId], references: [id], onDelete: Cascade)
  name           String
  position       String
  tenure         String
  age            Int
  sex            String
}
