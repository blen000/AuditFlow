// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  permissions String[]
  isSpecial   Boolean  @default(false)
  users       User[]
}

model User {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  password   String
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  status     String   @default("Active")
  dateJoined DateTime @default(now())
  branch     String?
  district   String?
}

model District {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}

model Department {
  id   String @id @default(cuid())
  name String @unique
}

model RiskLevel {
  id   String @id @default(cuid())
  name String @unique
}

model FindingStatus {
  id   String @id @default(cuid())
  name String @unique
}

model AuditHierarchyNode {
  id           String               @id @default(cuid())
  parentId     String?
  parent       AuditHierarchyNode?  @relation("HierarchyTree", fields: [parentId], references: [id])
  children     AuditHierarchyNode[] @relation("HierarchyTree")
  level        Int
  number       String               @unique
  title        String
  customFields Json?                // Store CustomFieldDefinition[]
  findings     AuditFinding[]
}

model AuditFinding {
  id                        String             @id @default(cuid()) // Hierarchical ID, e.g., "1.1.1"
  hierarchyNodeId           String
  hierarchyNode             AuditHierarchyNode @relation(fields: [hierarchyNodeId], references: [id])
  title                     String             // Inherited from node
  details                   String
  riskLevel                 String
  branchOrDepartment        String
  status                    String
  recommendation            String
  auditeeAgreement          String             @default("Pending")
  auditeeResponse           String?
  auditeeAttachmentFilename String?
  auditCause                String?
  auditEffect               String?
  involvedAmounts           Json?              // Store InvolvedAmount[]
  involvedCases             Json?              // Store InvolvedCase[]
  progressUpdates           Json?              // Store ProgressUpdate[]
  teamLeader                String
  teamMembers               String[]
  assignedDate              DateTime?
  dateCommunicated          DateTime?
  finalizationDate          DateTime?
  revalidationDate          DateTime?
  mitigationDueDate         DateTime?
  tatDays                   Int                @default(15)
  followUpStatus            String?            @default("Pending")
  verbalComm                Json?              // Store CommunicationEntry[]
  writtenComm               Json?              // Store CommunicationEntry[]
  esc1                      Json?              // Store CommunicationEntry[]
  esc2                      Json?              // Store CommunicationEntry[]
  followUpRecommendations   String?
  isClosed                  Boolean            @default(false)
  collaboratingWith         String?
  forwardingHistory         Json?              // Store ForwardingEntry[]
  dynamicValues             Json?              // Store values for custom fields
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
}

model SpecialAudit {
  id                    String                   @id @default(cuid())
  shortSummary          String
  placement             String                   // Branch, District, H.O
  placementValue        String
  amountInvolved        Float
  recovered             Float
  pending               Float
  individuals           SpecialAuditIndividual[]
  actionDisciplinary    String
  gapWitnessed          String
  correctiveActionTaken String
  auditCause            String?
  auditEffect           String?
  recommendation        String?
  dateCreated           DateTime                 @default(now())
}

model SpecialAuditIndividual {
  id             String       @id @default(cuid())
  specialAuditId String
  specialAudit   SpecialAudit @relation(fields: [specialAuditId], references: [id], onDelete: Cascade)
  name           String
  position       String
  tenure         String
  age            Int
  sex            String
}
