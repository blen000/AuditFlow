// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  fullName              String
  email                 String   @unique
  password              String
  roleId                String
  role                  Role     @relation(fields: [roleId], references: [id])
  status                String   @default("Active")
  branch                String?
  district              String?
  dateJoined            DateTime @default(now())
  requirePasswordChange Boolean  @default(true)
  passwordLastChanged   DateTime @default(now())
  sessions              Session[]
  uploads               FileAttachment[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  fingerprint  String?  // To bind token to device/context
  expiresAt    DateTime // Absolute session timeout
  lastActiveAt DateTime @default(now()) // For idle timeout
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  permissions String[]
  isSpecial   Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  branches  Branch[]
}

model Branch {
  id         String   @id @default(cuid())
  name       String   @unique
  districtId String
  district   District @relation(fields: [districtId], references: [id])
}

model Department {
  id   String @id @default(cuid())
  name String @unique
}

model RiskLevel {
  id   String @id @default(cuid())
  name String @unique
}

model FindingStatus {
  id   String @id @default(cuid())
  name String @unique
}

model SpecialFindingCategory {
  id      String         @id @default(cuid())
  name    String         @unique
  audits  SpecialAudit[]
}

model AuditHierarchyNode {
  id           String               @id @default(cuid())
  parentId     String?
  parent       AuditHierarchyNode?  @relation("HierarchyTree", fields: [parentId], references: [id])
  children     AuditHierarchyNode[] @relation("HierarchyTree")
  level        Int
  number       String               @unique
  title        String
  customFields Json?                // Array of CustomFieldDefinition
  findings     AuditFinding[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model AuditFinding {
  id                String   @id @default(cuid())
  title             String   // Title from the hierarchy node at time of creation
  details           String
  riskLevel         String
  branchOrDepartment String
  recommendation    String
  status            String   @default("Open")
  auditeeAgreement  String   @default("Pending")
  
  auditCause        String?
  auditEffect       String?
  
  involvedAmounts   Json?    // Array of InvolvedAmount
  involvedCases     Json?    // Array of InvolvedCase
  
  teamLeader        String?
  teamMembers       Json?    // Array of strings
  
  assignedDate      DateTime?
  dateCommunicated  DateTime?
  finalizationDate  DateTime?
  tatDays           Int?     @default(15)
  
  revalidationDate  DateTime?
  mitigationDueDate DateTime?
  auditeeResponse   String?
  auditeeAttachmentFilename String?
  
  progressUpdates   Json?    // Array of ProgressUpdate
  dynamicValues     Json?    // Key-value pairs for node-specific fields
  
  hierarchyNodeId   String
  hierarchyNode     AuditHierarchyNode @relation(fields: [hierarchyNodeId], references: [id])
  
  isClosed          Boolean  @default(false)
  followUpStatus    String?  @default("Pending")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  attachments       FileAttachment[]
}

model FileAttachment {
  id            String   @id @default(cuid())
  filename      String   // Secure, generated filename
  originalName  String   // Original filename for display
  mimeType      String
  size          Int
  uploaderId    String
  uploader      User     @relation(fields: [uploaderId], references: [id])
  findingId     String?
  finding       AuditFinding? @relation(fields: [findingId], references: [id])
  category      String?  // e.g., 'auditee_response', 'progress_update', 'finding_source'
  createdAt     DateTime @default(now())
}

model SpecialAudit {
  id                    String   @id @default(cuid())
  shortSummary          String
  placement             String
  placementValue        String
  categoryId            String?
  category              SpecialFindingCategory? @relation(fields: [categoryId], references: [id])
  amountInvolved        Float
  recovered             Float
  pending               Float
  actionDisciplinary    String
  gapWitnessed          String
  correctiveActionTaken String
  auditCause            String?
  auditEffect           String?
  recommendation        String?
  dateCreated           DateTime @default(now())
  individuals           SpecialAuditIndividual[]
}

model SpecialAuditIndividual {
  id             String       @id @default(cuid())
  name           String
  position       String
  tenure         String
  age            Int
  sex            String
  specialAuditId String
  specialAudit   SpecialAudit @relation(fields: [specialAuditId], references: [id], onDelete: Cascade)
}

model SecurityAuditLog {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  eventType     String   // e.g., "AUTH_LOGIN", "AUTH_FAILURE", "AUTHZ_FAILURE", "ROLE_CHANGE", "SENSITIVE_OP"
  severity      String   // e.g., "INFO", "WARN", "HIGH_RISK"
  userId        String?
  email         String?  // Helpful for tracking auth failures
  action        String   // Descriptive action
  details       String?  // Non-sensitive additional info
  ipAddress     String?
  userAgent     String?
  resourceId    String?  // ID of the resource affected (e.g., finding ID, role ID)
  resourceType  String?  // Type of resource (e.g., "Finding", "Role", "SystemSetting")
  
  @@index([eventType])
  @@index([userId])
  @@index([timestamp])
}
