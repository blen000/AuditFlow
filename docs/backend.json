{
  "entities": {
    "Branch": {
      "title": "Branch",
      "type": "object",
      "description": "Represents a bank branch or department.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the bank branch or department."
        },
        "district": {
          "type": "string",
          "description": "The district the branch belongs to."
        }
      },
      "required": ["name", "district"]
    },
    "District": {
      "title": "District",
      "type": "object",
      "description": "Represents an organizational district.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the district."
        }
      },
      "required": ["name"]
    },
    "RiskLevel": {
      "title": "RiskLevel",
      "type": "object",
      "description": "Represents a risk level for an audit finding.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the risk level (e.g., High, Medium, Low)."
        }
      },
      "required": ["name"]
    },
    "Status": {
      "title": "Status",
      "type": "object",
      "description": "Represents the status of an audit finding.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the status (e.g., Open, In Progress)."
        }
      },
      "required": ["name"]
    },
    "AuditFinding": {
      "title": "AuditFinding",
      "type": "object",
      "description": "Represents a single audit finding.",
      "properties": {
        "title": { "type": "string" },
        "details": { "type": "string" },
        "riskLevel": { "type": "string" },
        "branchOrDepartment": { "type": "string" },
        "recommendation": { "type": "string" },
        "status": { "type": "string" },
        "revalidationDate": { "type": "string", "format": "date-time" },
        "auditeeAgreement": { "type": "string", "enum": ["Pending", "Agreed", "Declined"] },
        "mitigationDueDate": { "type": "string", "format": "date-time" },
        "auditeeResponse": { "type": "string" },
        "auditeeAttachmentFilename": { "type": "string" },
        "progressUpdates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "date": { "type": "string", "format": "date-time" },
              "details": { "type": "string" },
              "attachmentFilename": { "type": "string" }
            },
            "required": ["id", "date", "details"]
          }
        },
        "findingAttachments": { "type": "array", "items": { "type": "string" } },
        "recommendationAttachments": { "type": "array", "items": { "type": "string" } },
        "auditCause": { "type": "string" },
        "auditCauseAttachments": { "type": "array", "items": { "type": "string" } },
        "auditEffect": { "type": "string" },
        "auditEffectAttachments": { "type": "array", "items": { "type": "string" } },
        "involvedAmounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "amount": { "type": "number" }
            },
            "required": ["name", "amount"]
          }
        },
        "involvedCases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "ownerName": { "type": "string" },
              "status": { "type": "string", "enum": ["Open", "Resolved"] }
            },
            "required": ["id", "ownerName", "status"]
          }
        }
      },
      "required": ["title", "details", "riskLevel", "branchOrDepartment", "recommendation", "status", "auditeeAgreement"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/branches/{branchId}": {
      "schema": { "$ref": "#/entities/Branch" },
      "description": "Stores all bank branches and departments."
    },
    "/districts/{districtId}": {
      "schema": { "$ref": "#/entities/District" },
      "description": "Stores all organizational districts."
    },
    "/riskLevels/{riskLevelId}": {
      "schema": { "$ref": "#/entities/RiskLevel" },
      "description": "Stores all possible risk levels for findings."
    },
    "/statuses/{statusId}": {
      "schema": { "$ref": "#/entities/Status" },
      "description": "Stores all possible statuses for findings."
    },
    "/findings/{findingId}": {
      "schema": { "$ref": "#/entities/AuditFinding" },
      "description": "Stores all audit findings across all branches."
    }
  }
}
